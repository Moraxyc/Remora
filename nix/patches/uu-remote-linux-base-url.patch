+/// Cloud API base URL (`UU_BASE_URL` or config `"base_url"`), without a trailing slash.
+pub fn base_url() -> String {
+    let raw = std::env::var("UU_BASE_URL").ok().map(|v| v.trim().to_owned()).filter(|v| !v.is_empty())
+        .or_else(|| file().ok().flatten().and_then(|f| f.get("base_url")).and_then(|v| v.as_str()).map(|v| v.trim().to_owned()).filter(|v| !v.is_empty()))
+        .unwrap_or_else(|| crate::auth::DEFAULT_BASE_URL.into());
+    raw.trim_end_matches('/').to_owned()
+}
+

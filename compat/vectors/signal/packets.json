{
  "suite": "signal_packets",
  "cases": [
    {
      "name": "engineio_open_handshake",
      "frames": [
        {
          "kind": "text",
          "hex": "307b22736964223a22616263222c227570677261646573223a5b5d2c2270696e67496e74657276616c223a32353030302c2270696e6754696d656f7574223a32303030302c226d61785061796c6f6164223a313030303030307d"
        }
      ],
      "expected": {
        "packet": "open",
        "sid": "abc",
        "ping_interval": 25000,
        "ping_timeout": 20000
      }
    },
    {
      "name": "engineio_ping",
      "frames": [{ "kind": "text", "hex": "32" }],
      "expected": { "packet": "ping" }
    },
    {
      "name": "engineio_pong",
      "frames": [{ "kind": "text", "hex": "33" }],
      "expected": { "packet": "pong" }
    },
    {
      "name": "socketio_connected",
      "frames": [
        { "kind": "text", "hex": "34307b22736964223a2278227d" }
      ],
      "expected": { "packet": "connected" }
    },
    {
      "name": "released_event",
      "frames": [
        {
          "kind": "text",
          "hex": "34325b2272656c6561736564222c7b226963655f6964223a2269227d5d"
        }
      ],
      "expected": {
        "packet": "event",
        "event_name": "released",
        "attachments_hex": []
      }
    },
    {
      "name": "refresh_reconnect_key_ack",
      "frames": [
        {
          "kind": "text",
          "hex": "343331375b2273756363657373222c7b227265636f6e6e6563745f6b6579223a226b227d5d"
        }
      ],
      "expected": {
        "packet": "ack",
        "id": 17,
        "attachments_hex": []
      }
    },
    {
      "name": "be_controlled_binary_event",
      "frames": [
        {
          "kind": "text",
          "hex": "3435312d5b2262652d636f6e74726f6c6c6564222c7b226963655f6964223a2269222c226170705f64617461223a7b225f706c616365686f6c646572223a747275652c226e756d223a307d7d5d"
        },
        {
          "kind": "binary",
          "hex": "0801"
        }
      ],
      "expected": {
        "packet": "event",
        "event_name": "be-controlled",
        "attachments_hex": ["0801"]
      }
    },
    {
      "name": "unknown_event_is_preserved",
      "frames": [
        {
          "kind": "text",
          "hex": "34325b226675747572655f6576656e74222c7b2276223a317d5d"
        }
      ],
      "expected": {
        "packet": "event",
        "event_name": "future_event",
        "signal_variant": "unknown"
      }
    }
  ]
}

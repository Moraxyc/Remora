[Unit]
Description=Remora's listening socket
Documentation=https://github.com/Moraxyc/Remora

[Socket]
# Keep this the address `listen` names in remora.toml: Remora serves on this socket instead, but
# still derives the default `public_url` from `listen`.
ListenStream=[::1]:8680
# Or listen on a Unix socket (also set `listen` and `public_url` in remora.toml, and grant the
# reverse proxy access with SocketGroup/SocketMode):
# ListenStream=/run/remora/remora.sock
# SocketGroup=www-data
# SocketMode=0660

[Install]
WantedBy=sockets.target
